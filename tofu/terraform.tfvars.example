# ==============================================================================
# Proxmox VE Connection Details
# ==============================================================================
# Endpoint URL of your Proxmox VE cluster API
proxmox_endpoint  = "https://pve.example.com:8006/"

# API Token (Recommended: created in Datacenter -> Permissions -> API Tokens)
# Format: USER@REALM!TOKENID=UUID-SECRET
proxmox_api_token = "root@pam!opentofu=00000000-0000-0000-0000-000000000000"

# Allow self-signed SSL certificates
proxmox_insecure  = true

# ==============================================================================
# Cluster Nodes
# ==============================================================================
# Node 1: Cluster Lead & Utility Host - lightweight workloads & DevOps
utility_node_name    = "proxmox"
utility_node_address = "10.0.0.10"

# Node 2: Primary Compute & Media Host
compute_node_name    = "tuxmox"
compute_node_address = "10.0.0.20"

# Target node for declarative application containers (default: tuxmox, overridable to proxmox)
app_node_name        = "tuxmox"

# ==============================================================================
# Plex LXC Configuration (Node: tuxmox)
# ==============================================================================
plex_ct_id            = 101
plex_hostname         = "plex"
plex_cores            = 4
plex_memory           = 4096
plex_swap             = 1024
plex_disk_storage     = "local-lvm"
plex_disk_size        = 50
plex_template_file_id = "local:vztmpl/debian-12-standard_12.12-1_amd64.tar.zst"

# Networking
plex_network_bridge = "vmbr0"
plex_mac_address    = "bc:24:11:00:01:01"
plex_ipv4_address   = "dhcp"

# SSH keys to inject for root access
plex_ssh_public_keys = [
  # "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... root@mgmt-devops",
  # "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACA... root@proxmox",
  # "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACA... root@tuxmox"
]

# LXC Privilege mode (false = privileged in OpenTofu bpg/proxmox)
plex_unprivileged = false

