# ==============================================================================
# Homelab Secrets Template / 1Password Single-Note Reference
# ==============================================================================
# This template defines all sensitive configuration variables across the homelab
# infrastructure. To bootstrap the cluster:
#
# Option A (1Password CLI - Single Secure Note):
#   op read "op://Private/Homelab Master Secrets/notesPlain" > secrets.env
#   chmod 600 secrets.env
#   ./scripts/bootstrap-secrets.sh
#
# Option B (Manual Configuration):
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#   # Edit secrets.env with your real credentials
#   ./scripts/bootstrap-secrets.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Proxmox VE API & Cluster Credentials
# ------------------------------------------------------------------------------
# API Token created in Datacenter -> Permissions -> API Tokens
# Format: USER@REALM!TOKENID=UUID-SECRET
PROXMOX_ENDPOINT="https://10.0.0.10:8006/"
PROXMOX_API_TOKEN="root@pam!opentofu=00000000-0000-0000-0000-000000000000"
PROXMOX_INSECURE="true"

# ------------------------------------------------------------------------------
# 2. Network Infrastructure & Node Topology
# ------------------------------------------------------------------------------
NODE1_IP="10.0.0.10"
NODE2_IP="10.0.0.20"
NAS_IP="10.0.0.4"
DEFAULT_GATEWAY_IP="10.0.0.1"
LAN_SUBNET_CIDR="10.0.0.0/24"
ADGUARD_PRIMARY_IP="10.0.0.201"
ADGUARD_SECONDARY_IP="10.0.0.202"
UPSTREAM_DNS_IP="10.0.0.101"
CLOUDFLARED_PRIMARY_IP="10.0.0.66"
CLOUDFLARED_SECONDARY_IP="10.0.0.65"
MONITORING_IP="10.0.0.62"
MGMT_DEVOPS_IP="10.0.0.56"

# ------------------------------------------------------------------------------
# 3. Cluster SSH Public Keys (Injected into all LXC containers for root access)
# ------------------------------------------------------------------------------
SSH_KEY_MGMT="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... root@mgmt-devops"
SSH_KEY_NODE1="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACA... root@node-1"
SSH_KEY_NODE2="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACA... root@node-2"

# Default hypervisor target node for application containers (node-2 or node-1)
APP_NODE_NAME="node-2"

# ------------------------------------------------------------------------------
# 4. Cloudflare Zero Trust Ingress Tunnel
# ------------------------------------------------------------------------------
# Tunnel Token for Cloudflared HA instances (CT 510 on node-1 & CT 511 on node-2)
CLOUDFLARE_TUNNEL_TOKEN="eyJhIjoi..."

# ------------------------------------------------------------------------------
# 5. AdGuard Home Core DNS / DHCP & HA Sync
# ------------------------------------------------------------------------------
ADGUARD_ADMIN_USER="admin"
ADGUARD_ADMIN_HASH='$2a$10$EXAMPLE_ADMIN_BCRYPT_HASH_REPLACE_ME'
ADGUARD_SYNC_USER="sync"
ADGUARD_SYNC_PASS="change_me_to_strong_sync_password"
ADGUARD_SYNC_HASH='$2b$12$EXAMPLE_SYNC_BCRYPT_HASH_REPLACE_ME'

# ------------------------------------------------------------------------------
# 6. Monitoring & Alerting (Uptime Kuma, Proxmox, & Security Notifications)
# ------------------------------------------------------------------------------
UPTIME_KUMA_ADMIN_USER="admin"
UPTIME_KUMA_ADMIN_PASS="change_me_to_strong_password"
UPTIME_KUMA_ADMIN_HASH='$2a$10$EXAMPLE_ADMIN_BCRYPT_HASH_REPLACE_ME'
UPTIME_KUMA_BASE_URL="https://kuma.example.com"
# Discord webhook URL for notifications on service outage / recovery / backup failures (backward compatible)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/1234567890/EXAMPLE_WEBHOOK_TOKEN"
DISCORD_MONITORING_WEBHOOK_URL="https://discord.com/api/webhooks/1234567890/EXAMPLE_WEBHOOK_TOKEN"
# Dedicated Security Webhook for vulnerability scans, daily audit summaries, and CVE alerts
DISCORD_SECURITY_WEBHOOK_URL="https://discord.com/api/webhooks/1234567890/EXAMPLE_SECURITY_WEBHOOK_TOKEN"
